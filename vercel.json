{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "pnpm --filter ./artifacts/smart-kisan-bharat run build",
  "outputDirectory": "artifacts/smart-kisan-bharat/dist",
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}