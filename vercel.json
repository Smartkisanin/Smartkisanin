{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter ./artifacts/smart-kisan-bharat run build",
  "outputDirectory": "artifacts/smart-kisan-bharat/dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/artifacts/smart-kisan-bharat/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/smart-kisan-bharat/dist/index.html"
    }
  ]
}
